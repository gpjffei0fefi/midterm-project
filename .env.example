# Optional shared leaderboard (Supabase). Copy this file to .env.local and fill
# in the values from your Supabase project: Project Settings -> API.
# Leave them unset and the game simply runs without a leaderboard.
#
# Use the "anon" / public key only. Never put the service_role key here: Vite
# bakes these values into the browser bundle, so anything here is public.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional Hard Mode AI agent (Gemini, with Google Search grounding).
# Leave unset and Hard Mode just uses the tier-based coin-flip AI, same as
# every other mode's opponents.
#
# NEVER prefix this with VITE_ or NEXT_PUBLIC_ — it must stay server-only.
# It is read only by api/_lib/geminiClient.js (a server-only module; nothing
# under src/ imports it), via `vercel dev` locally or Vercel's own project
# environment variables in production. See DOCUMENTATION.md for the model,
# free-tier limits, and fallback behavior.
GEMINI_API_KEY=your-gemini-api-key
