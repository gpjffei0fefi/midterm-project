# Optional shared leaderboard (Supabase). Copy this file to .env.local and fill
# in the values from your Supabase project: Project Settings -> API.
# Leave them unset and the game simply runs without a leaderboard.
#
# Use the "anon" / public key only. Never put the service_role key here: Vite
# bakes these values into the browser bundle, so anything here is public.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
